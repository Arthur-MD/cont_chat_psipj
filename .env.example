# Copie para .env e preencha antes de rodar `docker compose up -d`.
# NUNCA commite o .env de verdade (já está no .gitignore).

# --- Rails / Chatwoot ---
# Gere com: openssl rand -hex 64
SECRET_KEY_BASE=troque_por_uma_string_aleatoria_de_64_bytes_hex

# URL pública do Chatwoot (o domínio configurado no Caddyfile, com https://)
FRONTEND_URL=https://chat.psicologopj.com.br

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
DEFAULT_LOCALE=pt_BR

# Deixe "true" só até criar sua conta admin (passo 5 do guia); depois mude
# para "false" para ninguém mais conseguir se cadastrar sozinho.
ENABLE_ACCOUNT_SIGNUP=true

# --- Banco de dados (usado pelo container postgres E lido pelo rails) ---
POSTGRES_USERNAME=postgres
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_DATABASE=chatwoot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Anexos de mídia (fotos/áudio do WhatsApp) ---
# "local" funciona para começar (fica em volume Docker). Para produção séria,
# considere trocar por S3-compatível (Cloudflare R2 tem 10GB grátis) — ver
# seção opcional no guia SETUP.md.
ACTIVE_STORAGE_SERVICE=local

# --- E-mail (opcional, mas necessário p/ convite de atendente e "esqueci senha") ---
# MAILER_SENDER_EMAIL=
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=plain
# SMTP_ENABLE_STARTTLS_AUTO=true
