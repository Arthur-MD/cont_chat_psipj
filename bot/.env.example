# --- Chatwoot ---
# Base da sua instância (sem barra no final).
# Rodando na MESMA VPS via chatwoot/docker-compose.yml, use a rede interna:
#   CHATWOOT_BASE_URL=http://rails:3000
# (mais rápido e não depende do DNS público)
CHATWOOT_BASE_URL=http://rails:3000
# ID da conta (aparece na URL: /app/accounts/<ID>/...)
CHATWOOT_ACCOUNT_ID=1
# Access token do Agent Bot (gerado no rails console: bot.access_token.token)
CHATWOOT_BOT_TOKEN=cole_o_token_do_bot_aqui
# Secret p/ verificar assinatura HMAC do webhook (a maioria das instâncias
# Chatwoot NÃO assina webhooks de Agent Bot — deixe vazio e use WEBHOOK_TOKEN)
CHATWOOT_BOT_SECRET=
# Token secreto embutido na URL do webhook — a autenticação real do bot.
# Gere com: openssl rand -hex 16
# e cadastre a outgoing_url do Agent Bot como:
#   https://triagem.SEU-DOMINIO.com.br/webhook/<este_token>
WEBHOOK_TOKEN=

# --- Anthropic (triagem por IA) ---
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de triagem. haiku = mais barato p/ volume; sonnet = mais robusto.
TRIAGE_MODEL=claude-sonnet-4-6

# --- Roteamento ---
# Mapa "departamento" -> team_id do Chatwoot, em JSON.
# Pegue os team_id em Settings > Teams (ou via API /api/v1/accounts/<id>/teams).
TEAM_MAP={"vendas": 1, "suporte": 2}

# Nome da empresa, usado no prompt de triagem
COMPANY_NAME=Minha Empresa
