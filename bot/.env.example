# --- Chatwoot ---
# Base da sua instância (sem barra no final).
# Rodando na MESMA VPS via chatwoot/docker-compose.yml, use a rede interna:
#   CHATWOOT_BASE_URL=http://rails:3000
# (mais rápido e não depende do DNS público)
CHATWOOT_BASE_URL=http://rails:3000
# ID da conta (aparece na URL: /app/accounts/<ID>/...)
CHATWOOT_ACCOUNT_ID=1
# Access token do Agent Bot (gerado no rails console: bot.access_token.token)
CHATWOOT_BOT_TOKEN=cole_o_token_do_bot_aqui
# Secret p/ verificar assinatura HMAC do webhook (a maioria das instâncias
# Chatwoot NÃO assina webhooks de Agent Bot — deixe vazio e use WEBHOOK_TOKEN)
CHATWOOT_BOT_SECRET=
# Token secreto embutido na URL do webhook — a autenticação real do bot.
# Gere com: openssl rand -hex 16
# e cadastre a outgoing_url do Agent Bot como:
#   https://triagem.SEU-DOMINIO.com.br/webhook/<este_token>
WEBHOOK_TOKEN=

# Token de um AGENTE (não é o CHATWOOT_BOT_TOKEN acima): faça login no
# Chatwoot, vá em Perfil > Configurações de Perfil > Token de acesso, e copie.
# Necessário para o bot ler o histórico da conversa (sem ele, o bot só vê a
# última mensagem do cliente) e para a devolução automática abaixo.
CHATWOOT_ADMIN_TOKEN=

# --- Devolução automática por inatividade ---
# Conversas 'open' (com humano) sem atividade por esse tempo voltam sozinhas
# para 'pending' (bot), em silêncio — sem avisar o cliente. Desligada se
# CHATWOOT_ADMIN_TOKEN estiver vazio.
AUTO_RETURN_HOURS=24
AUTO_RETURN_CHECK_MINUTES=15
# Restringe a checagem a um inbox específico (opcional; vazio = todos).
AUTO_RETURN_INBOX_ID=

# --- Provedor de IA para a triagem ---
# Escolha "anthropic" (Claude) ou "openai" (GPT). Só o provedor escolhido
# precisa da chave preenchida; o outro pode ficar vazio.
LLM_PROVIDER=anthropic

# Anthropic / Claude (usado quando LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
# haiku = mais barato p/ volume; sonnet = mais robusto.
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI / GPT (usado quando LLM_PROVIDER=openai)
OPENAI_API_KEY=
# gpt-4o-mini = barato e bom p/ triagem; gpt-4o = mais robusto.
OPENAI_MODEL=gpt-4o-mini

# --- Roteamento ---
# Mapa "departamento" -> team_id do Chatwoot, em JSON.
# Pegue os team_id em Settings > Teams (ou via API /api/v1/accounts/<id>/teams).
TEAM_MAP={"vendas": 1, "suporte": 2}

# Nome da empresa, usado no prompt de triagem
COMPANY_NAME=Minha Empresa
